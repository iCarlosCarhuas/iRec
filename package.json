{
  "name": "irec",
  "version": "0.3.0",
  "private": true,
  "description": "iRec — PWA de albumes digitales tematicos",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @irec/contracts build && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @irec/web dev",
    "dev:api": "pnpm --filter @irec/api dev",
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "dev:infra:ps": "docker compose -f infra/docker-compose.dev.yml ps",
    "dev:infra:logs": "docker compose -f infra/docker-compose.dev.yml logs -f",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "openapi:check": "pnpm --filter @irec/api openapi:check",
    "openapi:export": "pnpm --filter @irec/api openapi:export",
    "db:generate": "pnpm --filter @irec/api db:generate",
    "db:migrate": "pnpm --filter @irec/api db:migrate",
    "db:apply": "pnpm db:generate && pnpm db:migrate",
    "db:studio": "pnpm --filter @irec/api db:studio",
    "db:diagnose": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/diagnose-db.ps1",
    "identity:verify": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/verify-identity-backend.ps1",
    "identity:verify:backend": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/verify-identity-backend.ps1",
    "identity:verify:frontend": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/verify-identity-frontend.ps1 -SkipInstall",
    "totp:hyperframes:check": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/check-totp-hyperframes.ps1",
    "irec:doctor": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/irec.ps1 doctor",
    "irec:setup": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/irec.ps1 setup",
    "irec:dev": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/irec.ps1 up",
    "irec:stop": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/irec.ps1 down",
    "irec:status": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/irec.ps1 status",
    "irec:logs": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/irec.ps1 logs",
    "verify:docker": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/verify-fullstack-docker.ps1"
  }
}
