{
  "name": "@irec/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @irec/contracts build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @irec/contracts build",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:album && pnpm test:storage",
    "test:album": "tsx --test test/album.policy.test.ts",
    "preopenapi:check": "pnpm --filter @irec/contracts build",
    "openapi:check": "tsx src/openapi/check.ts",
    "preopenapi:export": "pnpm --filter @irec/contracts build",
    "openapi:export": "tsx src/openapi/export.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test:storage": "tsx --test test/storage.domain.test.ts"
  },
  "dependencies": {
    "@irec/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@scalar/nestjs-api-reference": "^1.2.18",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "jose": "^6.1.0",
    "nodemailer": "^10.0.9",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
